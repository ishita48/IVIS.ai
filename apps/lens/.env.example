# LENS — apps/lens
#
# cp .env.example .env.local, then fill in the keys marked REQUIRED.
# Every variable below is read by code in this directory; nothing here is
# aspirational. Do not commit .env.local.
#
# Generated from the process.env references in apps/lens. If you add a new
# one in code, add it here in the same commit.

# ── Auth (Clerk) — REQUIRED, the app will not boot without these ──────
# Read by @clerk/nextjs itself (middleware.ts, app/layout.tsx), not by our
# own code, which is why you will not find them in a grep for process.env.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Only needed if you run the Clerk → Mongo webhook (app/api/webhooks/clerk).
CLERK_WEBHOOK_SECRET=

# ── Database — REQUIRED ───────────────────────────────────────────────
# lib/mongodb.ts throws on startup if MONGODB_URI is unset.
MONGODB_URI=
MONGODB_DB=lens
# Comma-separated DNS servers, for networks where Atlas SRV lookup fails.
# Leave blank unless `npm run db:setup` cannot resolve the cluster.
MONGODB_DNS_SERVERS=

# ── OpenAI — REQUIRED (vision is the P0 demo loop) ────────────────────
OPENAI_API_KEY=
OPENAI_MODEL_VISION=gpt-4o-2024-08-06
OPENAI_EMBED_MODEL=text-embedding-3-small
# Fallback text path in lib/llm.ts, used when LLM_PRIMARY=openai or Gemini fails.
OPENAI_MODEL_CHAT=gpt-4o-mini
OPENAI_MODEL_GEN=gpt-4o-mini

# ── Anthropic — REQUIRED for LENS Pointer and LENS Guide ──────────────
# Without it /api/pointer/screen and /api/guide/step return "offline".
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_POINTER=claude-sonnet-4-6
# Falls back to ANTHROPIC_MODEL_POINTER when unset.
ANTHROPIC_MODEL_GUIDE=

# ── Gemini / Gemma — text reasoning (lib/llm.ts) ──────────────────────
# GOOGLE_API_KEY is the one lib/llm.ts reads; GEMINI_API_KEY is accepted
# as an alias. Set one. With neither, reasoning falls back to OpenAI.
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
# "gemini" | "openai" — which provider lib/llm.ts tries first.
LLM_PRIMARY=gemini
# Set to any non-empty value to enable Gemma thinking mode.
GEMMA_THINKING=
# Set to any non-empty value to log provider failures to the server console.
LLM_DEBUG=

# ── Elastic — optional, sponsor path ──────────────────────────────────
# Unset: search falls back to Atlas vector search and everything still works.
# Local: http://localhost:9200 after `docker compose -f ../../infra/elastic/docker-compose.yml up -d`
# Cloud: the deployment endpoint plus ELASTIC_API_KEY.
ELASTIC_URL=
ELASTIC_API_KEY=
# Basic auth, only if you are not using an API key.
ELASTIC_USERNAME=
ELASTIC_PASSWORD=
# Set to "false" to keep Elastic indexed but make Atlas the primary reader.
ELASTIC_PRIMARY=
ELASTIC_INDEX=lens-sources
ELASTIC_EVENTS_INDEX=lens-events
ELASTIC_REASONING_INDEX=lens-reasoning

# ── ElevenLabs — optional, voice TA in camera mode ────────────────────
ELEVENLABS_API_KEY=
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# ── Deepgram — optional, think-aloud (lib/deepgram.ts) ────────────────
# Read by app/api/deepgram/route.ts, which mints short-lived browser tokens.
# The key needs Member permissions in the Deepgram console or the grant
# call returns 403. Unset: the route returns 503 and nothing else changes.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# ── Dropbox — optional, scaffold ──────────────────────────────────────
# /api/dropbox/ingest is currently a scaffold that returns 501. See README.
DROPBOX_ACCESS_TOKEN=
DROPBOX_NOTES_FOLDER=/notes

# ── Demo access — off by default (lib/demo-access.ts) ─────────────────
# DEMO_MODE=1 lets /live callers without a Clerk account use
# /api/vision/analyze, /api/pointer/screen and /api/guide/step with a
# bearer token from POST /api/demo/token. Tokens are HMAC-signed with
# DEMO_TOKEN_SECRET (16+ random characters) and expire after 30 minutes.
# Unset: the token route returns 404 and the three routes behave as before.
# These routes spend OpenAI and Anthropic credits. Turn it on for the booth
# and off again after.
DEMO_MODE=
DEMO_TOKEN_SECRET=
# Caps, counted in process memory. Gated calls one token may make, and
# tokens one IP may mint per hour.
DEMO_MAX_ANALYSES_PER_TOKEN=20
DEMO_MAX_TOKENS_PER_IP_HOUR=5

# ── Sandbox (LENS Proof, P1) ──────────────────────────────────────────
# Public Piston by default; point at a self-hosted instance to avoid rate limits.
PISTON_URL=https://emkc.org/api/v2/piston/execute

# Grok Imagine reference charts for /api/datasets/run (optional; unset → null).
XAI_API_KEY=
