# ─────────────────────────────────────────────────────────────────────
# LENS — environment
# Copy to .env.local. Nothing here is optional for the P0 demo except
# where noted.
# ─────────────────────────────────────────────────────────────────────

# ── Database (existing StudyO Atlas cluster works as-is) ────────────
MONGODB_URI=mongodb+srv://...
MONGODB_DB=lens

# ── Auth ────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# ── LENS Vision (P0 — REQUIRED) ─────────────────────────────────────
# GPT-4o with Structured Outputs. Guided Camera Mode does not run
# without this key; there is no offline path by design.
OPENAI_API_KEY=sk-...
OPENAI_MODEL_VISION=gpt-4o
OPENAI_EMBED_MODEL=text-embedding-3-small

# ── LENS Pointer, screen mode (P0 — REQUIRED) ───────────────────────
# Claude Computer Use. Same call pattern proven in the macOS app.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_POINTER=claude-sonnet-4-6

# ── Reasoning / tutor text (Gemini primary, OpenAI fallback) ────────
GOOGLE_API_KEY=...
GEMINI_MODEL=gemma-4-26b-a4b-it
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
LLM_PRIMARY=gemini

# ── P1 sponsors ─────────────────────────────────────────────────────
ELEVENLABS_API_KEY=            # voice TA in camera mode
DROPBOX_ACCESS_TOKEN=          # course folder ingestion (route 501s without it)

# ── P1 Proof tier ───────────────────────────────────────────────────
PISTON_URL=https://emkc.org/api/v2/piston/execute

# ── Debug ───────────────────────────────────────────────────────────
LLM_DEBUG=
